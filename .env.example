# Clerk authentication (create development values in the Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Convex development deployment (created by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Set Clerk webhook signing secret and instance ID on the Convex deployment,
# not in browser variables. The receiver returns 503 until configured.
# CLERK_WEBHOOK_SIGNING_SECRET=
# CLERK_INSTANCE_ID=

# Optional master-data examples; configure on Convex only, never in production.
# PHARMAAI_ENABLE_FICTIONAL_SEED=false

NEXT_PUBLIC_CONVEX_SITE_URL=

# Advisory AI on the Convex deployment only. Select an approved model explicitly.
# No provider is called until a model/key AND organization usage controls are set.
# OPENAI_API_KEY=
# PHARMAAI_AI_MODEL=
# Usage reservations in Administration are estimates, not provider billing caps.
